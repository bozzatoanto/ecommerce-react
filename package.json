{
  "name": "ecommerce-react",
  "private": true,
  "version": "2.0.0",
  "author": "Antonella Bozzato",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env backend/index.js",
    "server:watch": "node --watch --env-file=.env backend/index.js",
    "dev:full": "concurrently \"npm run server:watch\" \"npm run dev\"",
    "migrate": "node --env-file=.env backend/migrar.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.0"
  }
}
